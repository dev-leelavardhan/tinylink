# =============================================================================
# TinyLink — Production Environment Template
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# App
NODE_ENV=production
PORT=3000
BASE_URL=https://api.yourdomain.com

# Database (PostgreSQL)
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>?sslmode=require

# Cache (Redis)
REDIS_URL=redis://<REDIS_USER>:<REDIS_PASSWORD>@<REDIS_HOST>:6379

# Auth (JWT) — Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=<GENERATE_A_RANDOM_64_BYTE_SECRET>
JWT_REFRESH_SECRET=<GENERATE_A_DIFFERENT_RANDOM_64_BYTE_SECRET>

# Short Code Generation
# Options: random | hash | hashids | auto-increment | snowflake
SHORT_CODE_STRATEGY=random
SHORT_CODE_LENGTH=7
SHORT_CODE_SNOWFLAKE_WORKER_ID=1
# SHORT_CODE_HASHIDS_SALT=<REQUIRED_WHEN_STRATEGY=hashids, MIN 16 CHARS>

# Analytics
# Generate with: openssl rand -hex 16
IP_HASH_SALT=<GENERATE_A_RANDOM_SECRET>
# GEOLITE2_DB_PATH=/path/to/GeoLite-Country.mmdb

# Mailer (SMTP) — required for email verification and password reset
MAILER_HOST=smtp.yourdomain.com
MAILER_PORT=587
MAILER_SECURE=false
MAILER_USER=<SMTP_USERNAME>
MAILER_PASS=<SMTP_PASSWORD>
MAILER_FROM=noreply@yourdomain.com

# Logging
LOG_LEVEL=info
