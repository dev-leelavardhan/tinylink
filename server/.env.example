# =============================================================================
# TinyLink — Production Environment Template
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# App
NODE_ENV=production
PORT=3000
BASE_URL=https://api.yourdomain.com

# Process role: `web` serves HTTP, `worker` runs background jobs, `all` runs
# both in one process. In production run separate `web` and `worker` services.
SERVICE_ROLE=all

# Comma-separated list of allowed CORS origins (omit to disable CORS).
# CORS_ORIGIN=https://app.yourdomain.com

# Number of trusted reverse-proxy hops in front of the app (Express
# `trust proxy`). MUST equal the real number of proxies/load balancers so that
# `req.ip` — which all IP-based rate limits use — can't be spoofed via
# X-Forwarded-For. Use 1 for a single proxy (default), a higher number for
# multiple hops, or 0 when the app is exposed directly to clients.
TRUST_PROXY=1

# Database (PostgreSQL)
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>?sslmode=require

# Cache (Redis)
REDIS_URL=redis://<REDIS_USER>:<REDIS_PASSWORD>@<REDIS_HOST>:6379

# Auth (JWT) — Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=<GENERATE_A_RANDOM_64_BYTE_SECRET>
JWT_REFRESH_SECRET=<GENERATE_A_DIFFERENT_RANDOM_64_BYTE_SECRET>

# Short Code Generation
# Options: random | hash | hashids | auto-increment | snowflake
SHORT_CODE_STRATEGY=random
SHORT_CODE_LENGTH=7
# Required (and MUST be unique per replica) only when STRATEGY=snowflake.
SHORT_CODE_SNOWFLAKE_WORKER_ID=1
# SHORT_CODE_HASHIDS_SALT=<REQUIRED_WHEN_STRATEGY=hashids, MIN 16 CHARS>

# Analytics
# Generate with: openssl rand -hex 16
IP_HASH_SALT=<GENERATE_A_RANDOM_SECRET>
# GEOLITE2_DB_PATH=/path/to/GeoLite-Country.mmdb

# Mailer (SMTP) — required for email verification and password reset
MAILER_HOST=smtp.yourdomain.com
MAILER_PORT=587
MAILER_SECURE=false
MAILER_USER=<SMTP_USERNAME>
MAILER_PASS=<SMTP_PASSWORD>
MAILER_FROM=noreply@yourdomain.com
# Optional display name for the From header.
# MAILER_NAME=TinyLink

# Logging (fatal | error | warn | info | debug | trace | silent)
LOG_LEVEL=info

# Observability (OpenTelemetry) — tracing is enabled only when an OTLP
# endpoint is configured.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SERVICE_NAME=tinylink-server

# =============================================================================
# Datastore credentials for docker-compose.prod.yml (not read by the app).
# =============================================================================
# POSTGRES_USER=tinylink
# POSTGRES_PASSWORD=<STRONG_PASSWORD>
# POSTGRES_DB=tinylink
# REDIS_PASSWORD=<STRONG_PASSWORD>
# Image refs deployed by CD (set by the deploy pipeline):
# IMAGE=ghcr.io/<owner>/<repo>/server:<sha>
# MIGRATE_IMAGE=ghcr.io/<owner>/<repo>/server:<sha>-migrate
