// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  PENDING_VERIFICATION
  DISABLED
  SUSPENDED
  LOCKED
}

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  passwordHash        String
  emailVerified       Boolean    @default(false)
  status              UserStatus @default(ACTIVE)
  tokenVersion        Int        @default(0)
  failedLoginAttempts Int        @default(0)
  lockUntil           DateTime?
  lastLoginAt         DateTime?
  lastLoginIp         String?
  lastUserAgent       String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  urls             Url[]
  verificationOtps VerificationOtp[]
  auditLogs        AuditLog[]
  sessions         Session[]
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String
  refreshTokenId   String?   @unique
  refreshTokenId   String?   @unique
  deviceName       String?
  browser          String?
  operatingSystem  String?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  lastUsedAt       DateTime  @default(now())
  revokedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
  @@index([expiresAt])
}

model Url {
  id String @id @default(cuid())

  originalUrl String

  shortCode String @unique

  customAlias String? @unique

  strategy String

  expiresAt DateTime?

  disabled Boolean @default(false)

  userId String?

  analytics Analytics[]

  lastAccessedAt DateTime?

  deletedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  slugs UrlSlug[]

  @@unique([originalUrl, strategy])
  @@index([expiresAt])
  @@index([disabled])
  @@index([userId])
}

model UrlSlug {
  id    String @id @default(cuid())
  slug  String @unique
  urlId String

  url Url @relation(fields: [urlId], references: [id], onDelete: Cascade)

  @@index([urlId])
}

model Analytics {
  id    String @id @default(cuid())
  urlId String
  url   Url    @relation(fields: [urlId], references: [id], onDelete: Cascade)

  timestamp DateTime @default(now())

  // Parsed from User-Agent
  browser String? // e.g. "Chrome", "Firefox"
  os      String? // e.g. "Windows", "macOS", "Linux"
  device  String? // e.g. "Desktop", "Mobile", "Tablet"

  // GeoIP
  country String? // ISO 3166-1 alpha-2 code, e.g. "US"
  city    String? // optional, from GeoLite2

  // Privacy: hash IP with salt, never store raw
  ipHash String

  // Referrer (normalized)
  referrer String?

  @@index([timestamp])
  @@index([urlId, timestamp])
  @@index([urlId, browser])
  @@index([urlId, country])
}

enum VerificationType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model VerificationOtp {
  id          String           @id @default(cuid())
  userId      String
  email       String
  type        VerificationType @default(EMAIL_VERIFICATION)
  otpHash     String
  salt        String           @default("")
  expiresAt   DateTime
  usedAt      DateTime?
  attempts    Int              @default(0)
  resendCount Int              @default(0)
  createdAt   DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email, expiresAt])
  @@index([userId, type])
}

enum AuditEvent {
  OTP_GENERATED
  OTP_RESENT
  OTP_VERIFIED
  OTP_EXPIRED
  OTP_FAILED
  OTP_RATE_LIMITED
  OTP_MAX_ATTEMPTS
  OTP_RESEND_COOLDOWN
  EMAIL_VERIFICATION_SUCCESS
  EMAIL_VERIFICATION_FAILED
  LOGIN_SUCCESS
  LOGIN_FAILED
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  SESSION_CREATED
  SESSION_REVOKED
  REFRESH_TOKEN_ISSUED
  REFRESH_TOKEN_REUSE
  REFRESH_FAILED
  SESSION_EXPIRED_ATTEMPT
  GLOBAL_LOGOUT
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_RESET_FAILED
}

model AuditLog {
  id        String     @id @default(cuid())
  userId    String?
  event     AuditEvent
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([event])
  @@index([createdAt])
}
