# =============================================================================
# TinyLink — Local Test Environment
# =============================================================================

# App
NODE_ENV=test
PORT=3001
BASE_URL=http://localhost:3001

# Database (PostgreSQL — separate test database on port 5433)
DATABASE_URL=postgresql://tinylink:tinylink@localhost:5433/tinylink_test

# Cache (Redis — same instance as dev)
REDIS_URL=redis://localhost:6379

# Auth (JWT — test secrets, not for production)
JWT_ACCESS_SECRET=test-jwt-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=test-jwt-refresh-secret-min-32-chars!

# Short Code Generation
SHORT_CODE_STRATEGY=random
SHORT_CODE_LENGTH=7
SHORT_CODE_SNOWFLAKE_WORKER_ID=1

# Analytics
IP_HASH_SALT=test-ip-hash-salt-min-16

# Logging
LOG_LEVEL=warn
