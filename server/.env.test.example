# =============================================================================
# TinyLink — Test Environment Template
# =============================================================================
# Copy this file to .env.test and fill in the values.

# App
NODE_ENV=test
PORT=3001
BASE_URL=http://localhost:3001

# Database (PostgreSQL — separate test database)
DATABASE_URL=postgresql://tinylink:tinylink@localhost:5433/tinylink_test

# Cache (Redis)
REDIS_URL=redis://localhost:6379

# Auth (JWT) — test secrets, not for production
JWT_ACCESS_SECRET=<GENERATE_A_RANDOM_32_BYTE_SECRET>
JWT_REFRESH_SECRET=<GENERATE_A_DIFFERENT_RANDOM_32_BYTE_SECRET>

# Short Code Generation
SHORT_CODE_STRATEGY=random
SHORT_CODE_LENGTH=7
SHORT_CODE_SNOWFLAKE_WORKER_ID=1

# Analytics
IP_HASH_SALT=<GENERATE_A_RANDOM_SECRET>

# Logging
LOG_LEVEL=warn
